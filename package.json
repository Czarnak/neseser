{
	"name": "neseser",
	"version": "0.8.1",
	"description": "Obsidian multi-project manager: projects as folders, tasks as notes, TickTick sync.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"deploy:test": "npm run build && node scripts/deploy-test-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"project-management",
		"ticktick"
	],
	"author": "LCZ",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"@vitest/coverage-v8": "^4.1.8",
		"esbuild": "^0.28.1",
		"obsidian": "^1.8.7",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}